# =============================================================================
# Git Submodules — Multi-Project Agent Template
# =============================================================================
#
# Cara pakai:
#   1. Ganti URL di tiap entry dengan repo yang sesuai
#   2. Ganti nama submodule (bagian dalam kurung siku) kalau perlu
#   3. Jalankan: git submodule update --init --recursive
#
# Untuk tambah legacy source atau service baru:
#   Copy blok yang sesuai, ganti nama + path + url
#
# =============================================================================

# -----------------------------------------------------------------------------
# LEGACY REFERENCE — source code lama sebagai acuan doc-reader
# Path: legacy/{source-name}/
# SOURCE_A_PATH / SOURCE_B_PATH di /init dan /resume mengarah ke sini
# -----------------------------------------------------------------------------

# [submodule "legacy-{source-a-name}"]
#     path = legacy/{source-a-name}
#     url  = https://github.com/your-org/{source-a-name}.git
#     branch = main

# [submodule "legacy-{source-b-name}"]
#     path = legacy/{source-b-name}
#     url  = https://github.com/your-org/{source-b-name}.git
#     branch = main

# Contoh:
# [submodule "legacy-web-partner"]
#     path = legacy/web-partner
#     url  = https://github.com/your-org/web-partner.git
#     branch = main

# -----------------------------------------------------------------------------
# SERVICES — service hasil rebuild / project baru
# Path: services/{service-name}/
# BASE_PATH di /init dan /resume mengarah ke sini
#
# Fresh boilerplate  → clone repo boilerplate kosong ke path ini dulu
# Existing service   → repo yang sudah ada kodenya
# -----------------------------------------------------------------------------

# [submodule "{service-name}"]
#     path = services/{service-name}
#     url  = https://github.com/your-org/{service-name}.git
#     branch = main

# Contoh:
# [submodule "otp-service"]
#     path = services/otp-service
#     url  = https://github.com/your-org/otp-service.git
#     branch = main
